---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"svg">;

const { class: className, ...rest } = Astro.props;
---

<!-- Markup ported from the design, minus its duplicated ears and face (the copy drawn under the sideburns, which the later copy covered completely) -->
<svg
  viewBox="0 0 200 200"
  role="img"
  aria-label="Illustrated portrait of Dan"
  data-avatar
  class:list={["block cursor-pointer", className]}
  {...rest}
>
  <defs>
    <clipPath id="dmClip">
      <circle cx="100" cy="100" r="100"></circle>
    </clipPath>
  </defs>
  <g clip-path="url(#dmClip)">
    <circle cx="100" cy="100" r="100" fill="var(--color-surface)"></circle>
    <clipPath id="dmShirt">
      <ellipse cx="100" cy="222" rx="90" ry="62"></ellipse>
    </clipPath>
    <g clip-path="url(#dmShirt)">
      <rect
        x="0"
        y="150"
        width="200"
        height="60"
        fill="var(--color-moss)"
      ></rect>
    </g>
    <rect
      x="84"
      y="140"
      width="32"
      height="34"
      rx="10"
      fill="var(--color-skin2)"
    ></rect>
    <rect
      x="54"
      y="62"
      width="20"
      height="44"
      rx="9"
      fill="var(--color-hair)"
    ></rect>
    <rect
      x="126"
      y="62"
      width="20"
      height="44"
      rx="9"
      fill="var(--color-hair)"
    ></rect>
    <circle cx="56" cy="112" r="9" fill="var(--color-skin2)"></circle>
    <circle cx="144" cy="112" r="9" fill="var(--color-skin2)"></circle>
    <ellipse
      cx="100"
      cy="106"
      rx="44"
      ry="50"
      fill="var(--color-skin)"
    ></ellipse>
    <ellipse cx="98" cy="60" rx="50" ry="22" fill="var(--color-hair)"></ellipse>
    <ellipse
      cx="112"
      cy="46"
      rx="40"
      ry="19"
      fill="var(--color-hair)"
      transform="rotate(8 112 46)"
    ></ellipse>
    <path
      d="M80 50 Q104 36 136 44"
      stroke="var(--color-hair2)"
      stroke-opacity=".35"
      stroke-width="3"
      fill="none"
      stroke-linecap="round"
    ></path>
    <path
      d="M58 116 Q60 164 100 170 Q140 164 142 116 Q136 136 120 135 Q100 131 80 135 Q64 136 58 116 Z"
      fill="var(--color-hair)"
    ></path>
    <path
      data-mouth
      d="M92 146 Q100 151 108 146"
      stroke="#9C5A4A"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    ></path>
    <rect
      x="66"
      y="82"
      width="24"
      height="5"
      rx="2.5"
      fill="var(--color-hair2)"
    ></rect>
    <rect
      x="110"
      y="82"
      width="24"
      height="5"
      rx="2.5"
      fill="var(--color-hair2)"
    ></rect>
    <g
      data-eyes
      class="origin-center [transform-box:fill-box] motion-safe:transition-[scale] motion-safe:duration-120 data-blink:scale-y-10"
    >
      <g data-pupils>
        <circle cx="79" cy="110" r="5" fill="#8A6A3E"></circle>
        <circle cx="121" cy="110" r="5" fill="#8A6A3E"></circle>
        <circle cx="79" cy="110" r="2.2" fill="var(--color-ink)"></circle>
        <circle cx="121" cy="110" r="2.2" fill="var(--color-ink)"></circle>
      </g>
    </g>
    <ellipse
      cx="100"
      cy="124"
      rx="6"
      ry="4"
      fill="var(--color-skin2)"
    ></ellipse>
    <circle
      cx="79"
      cy="110"
      r="17"
      fill="oklch(1 0 0)"
      fill-opacity=".14"
      stroke="oklch(0.5 0.02 60)"
      stroke-opacity=".85"
      stroke-width="4.5"
    ></circle>
    <circle
      cx="121"
      cy="110"
      r="17"
      fill="oklch(1 0 0)"
      fill-opacity=".14"
      stroke="oklch(0.5 0.02 60)"
      stroke-opacity=".85"
      stroke-width="4.5"
    ></circle>
    <path
      d="M95 106 Q100 101 105 106"
      stroke="oklch(0.5 0.02 60)"
      stroke-opacity=".85"
      stroke-width="4"
      fill="none"
    ></path>
  </g>
</svg>

<script>
  import { pupilOffset } from "../lib/avatar";

  // Eyes follow the cursor; a click blinks and opens the mouth for a moment
  const avatar = document.querySelector<SVGSVGElement>("[data-avatar]");
  const eyes = avatar?.querySelector<SVGGElement>("[data-eyes]");
  const pupils = avatar?.querySelector<SVGGElement>("[data-pupils]");
  const mouth = avatar?.querySelector<SVGPathElement>("[data-mouth]");

  if (avatar && eyes && pupils && mouth) {
    let frame = 0;
    let x = 0;
    let y = 0;

    const look = () => {
      frame = 0;
      const box = avatar.getBoundingClientRect();
      // The eyes sit a little below the middle of the face
      const offset = pupilOffset(
        x - (box.left + box.width / 2),
        y - (box.top + box.height * 0.57),
      );
      pupils.setAttribute(
        "transform",
        `translate(${offset.x.toFixed(2)} ${offset.y.toFixed(2)})`,
      );
    };

    window.addEventListener("pointermove", (event) => {
      x = event.clientX;
      y = event.clientY;
      frame ||= requestAnimationFrame(look);
    });

    const smile = mouth.getAttribute("d") ?? "";
    let blinkTimer = 0;
    let mouthTimer = 0;

    avatar.addEventListener("click", () => {
      eyes.dataset.blink = "";
      clearTimeout(blinkTimer);
      blinkTimer = window.setTimeout(() => delete eyes.dataset.blink, 150);

      // An open "o" mouth, filled in the line's colour
      mouth.setAttribute("d", "M95 148 A5 5 0 1 0 105 148 A5 5 0 1 0 95 148 Z");
      mouth.setAttribute("fill", mouth.getAttribute("stroke") ?? "none");
      clearTimeout(mouthTimer);
      mouthTimer = window.setTimeout(() => {
        mouth.setAttribute("d", smile);
        mouth.setAttribute("fill", "none");
      }, 320);
    });
  }
</script>
