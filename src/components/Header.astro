---
import Button from "./Button.astro";
import Container from "./Container.astro";
import MobileMenu from "./MobileMenu.astro";

const { pathname } = Astro.url;
const links = [{ label: "About", href: "/#about" }].map((link) => ({
  ...link,
  current: pathname.startsWith(link.href),
}));
---

<header class="bg-bg/84 backdrop-blur-[14px] border-b border-line sticky top-0 z-40">
  <Container as="nav" class="flex items-center justify-between py-3">
    <a
      href="/"
      class="group flex items-center gap-3 font-medium text-[15px] hover:text-ink no-underline"
    >
      <!-- Same face as public/favicon.svg, but on theme tokens so it follows night mode -->
      <svg
        viewBox="0 0 200 200"
        aria-hidden="true"
        class="block size-9 motion-safe:transition-transform motion-safe:duration-500 motion-safe:ease-(--ease-spring) motion-safe:group-hover:-rotate-10 motion-safe:group-hover:scale-108"
      >
        <circle cx="100" cy="100" r="100" fill="var(--color-surface)"></circle>
        <ellipse
          cx="100"
          cy="106"
          rx="46"
          ry="52"
          fill="var(--color-skin)"
        ></ellipse>
        <ellipse
          cx="98"
          cy="60"
          rx="52"
          ry="24"
          fill="var(--color-hair)"
        ></ellipse>
        <ellipse
          cx="112"
          cy="45"
          rx="42"
          ry="20"
          fill="var(--color-hair)"
          transform="rotate(8 112 45)"
        ></ellipse>
        <path
          d="M56 116 Q58 168 100 174 Q142 168 144 116 Q138 138 100 132 Q62 138 56 116 Z"
          fill="var(--color-hair)"
        ></path>
        <circle
          cx="79"
          cy="110"
          r="17"
          fill="none"
          stroke="oklch(0.45 0.02 60)"
          stroke-width="7"
        ></circle>
        <circle
          cx="121"
          cy="110"
          r="17"
          fill="none"
          stroke="oklch(0.45 0.02 60)"
          stroke-width="7"
        ></circle>
      </svg>
      Daniel McGrath
    </a>
    <div class="hidden nav:flex gap-0.5">
      {links.map((l) => (
        <a
          href={l.href}
          class="no-underline rounded-full hover:bg-surface hover:text-ink aria-[current=page]:bg-surface px-3.5 py-2 font-[450] text-sm transition-colors duration-200"
          aria-current={l.current ? "page" : undefined}
        >
          {l.label}
        </a>
      ))}
      <Button
        href="/resume/"
        size="sm"
        class="ml-2 transition-transform duration-200 hover:-translate-y-0.5"
      >
        Résumé
      </Button>
    </div>
    <MobileMenu links={links} />
  </Container>
</header>
