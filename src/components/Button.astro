---
import type { HTMLAttributes } from "astro/types";

type Props = {
  variant?: keyof typeof variants;
  size?: keyof typeof sizes;
} & HTMLAttributes<"a"> &
  HTMLAttributes<"button">;

const variants = {
  filled: "bg-ink text-onink hover:text-onink",
  outlined:
    "bg-bg text-ink hover:text-ink border border-line hover:border-ink transition-colors duration-200",
  soft: "bg-surface text-ink hover:text-ink hover:bg-line motion-safe:active:scale-94 transition-[background-color,translate,rotate,scale] duration-250 ease-[ease,var(--ease-spring),var(--ease-spring),var(--ease-spring)]",
};

const sizes = {
  sm: "px-4 py-2.25 text-sm",
  md: "px-4.5 py-3 min-h-11 text-sm",
  lg: "p-4 min-h-13 text-base",
  xl: "px-6 py-[15px] text-[15px]",
};

const {
  variant = "filled",
  size = "md",
  href,
  class: className,
  ...rest
} = Astro.props;

// A link when it navigates, a button when it acts in place
const Tag = href ? "a" : "button";
---

<Tag
  href={href}
  class:list={[
    "inline-flex cursor-pointer items-center justify-center gap-1 rounded-full font-medium no-underline",
    variants[variant],
    sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
