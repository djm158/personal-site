---
import "../styles/global.css";
import AvatarMini from "../assets/avatar-mini.svg";
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { THEME_KEY } from "../lib/theme";

interface Props {
  title?: string;
  description: string;
}

const { title, description } = Astro.props;
const siteName = "Daniel McGrath";
const fullTitle = title ? `${title} · ${siteName}` : siteName;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <!-- Night mode from an earlier visit, set before first paint so the page doesn't flash day first -->
    <script is:inline define:vars={{ key: THEME_KEY }}>
      try {
        if (localStorage.getItem(key) === "night") {
          document.documentElement.dataset.theme = "night";
        }
      } catch {}
    </script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href={AvatarMini.src} type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />
    <Font cssVariable="--font-instrument-serif" preload />
  </head>
  <body class="min-h-dvh flex flex-col bg-bg text-ink antialiased">
    <Header />

    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <div
      aria-hidden="true"
      class="z-60 bg-[url(/grain.svg)] opacity-50 fixed inset-0 pointer-events-none"
    ></div>
  </body>
</html>
