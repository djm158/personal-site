---
import { getEntry } from "astro:content";
import Avatar from "../components/Avatar.astro";
import Button from "../components/Button.astro";
import ContactSection from "../components/ContactSection.astro";
import Container from "../components/Container.astro";
import Emphasis from "../components/Emphasis.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Marquee from "../components/Marquee.astro";
import NightToggle from "../components/NightToggle.astro";
import TextLink from "../components/TextLink.astro";
import Layout from "../layouts/Layout.astro";
import { formatYearSpan } from "../lib/resume/dates";
import { loadResume } from "../lib/resume/load";

const { roles } = loadResume();
// The file loader only logs when the YAML can't be read, so fail the build here instead
const home = await getEntry("siteContent", "home");
if (!home) throw new Error("src/content/site-content.yaml did not load");
const { description, hero, marquee, about, experience, contact } = home.data;

// Each letter of the name hops and tilts on its own when hovered (static classes so Tailwind sees them).
// On load the letters hop in turn with the same lift and tilt, via the hop custom properties.
const letterMotions = [
  {
    hover: "motion-safe:hover:-translate-y-[0.14em] motion-safe:hover:-rotate-6",
    intro: "[--hop-y:-0.14em] [--hop-rotate:-6deg] [--hop-delay:150ms]",
  },
  {
    hover: "motion-safe:hover:-translate-y-[0.14em] motion-safe:hover:rotate-5",
    intro: "[--hop-y:-0.14em] [--hop-rotate:5deg] [--hop-delay:240ms]",
  },
  {
    hover: "motion-safe:hover:-translate-y-[0.14em] motion-safe:hover:-rotate-4",
    intro: "[--hop-y:-0.14em] [--hop-rotate:-4deg] [--hop-delay:330ms]",
  },
  {
    hover: "motion-safe:hover:-translate-y-[0.2em] motion-safe:hover:scale-130",
    intro: "[--hop-y:-0.2em] [--hop-scale:1.3] [--hop-delay:420ms]",
  },
];
---

<Layout description={description}>
  <section data-hero class="relative overflow-hidden">
    <!-- a soft glow that trails the cursor; hidden under reduced motion as it drifts by design -->
    <div
      data-glow
      aria-hidden="true"
      class="absolute top-0 left-0 size-140 -m-70 rounded-full bg-radial from-hair/30 to-transparent to-62% blur-xl pointer-events-none translate-x-225 translate-y-75 transition-[translate] duration-1000 ease-soft motion-reduce:hidden"
    ></div>
    <Container class="relative flex flex-wrap-reverse items-center gap-[clamp(40px,5vw,72px)] pt-[clamp(56px,8vw,112px)] pb-[clamp(56px,7vw,96px)]">
      <div class="flex-[1_1_400px] min-w-0">
        <div class="inline-flex items-center gap-2.5 font-mono font-medium text-xs uppercase mb-8 text-muted rounded-full border tracking-wider border-line py-1.75 pl-2.75 pr-3.5">
          <span class="size-2 rounded-full bg-moss motion-safe:animate-pulse"></span>
          <Emphasis segments={hero.status} />
        </div>
        <h1 class="font-serif text-[clamp(68px,10vw,136px)]/[0.88] tracking-[-0.03em]">
          {hero.heading.map((segment) =>
            segment.em ? (
              <em class="text-accent"><span class="sr-only">{segment.text}</span><span aria-hidden="true" class="inline-flex">{[...segment.text].map((char, i) => (
                <span class:list={["inline-block motion-safe:animate-hop motion-safe:transition-[translate,rotate,scale] motion-safe:duration-350 motion-safe:ease-spring", letterMotions[i % letterMotions.length].hover, letterMotions[i % letterMotions.length].intro]}>{char}</span>
              ))}</span></em>
            ) : segment.text,
          )}
        </h1>
        <p class="mt-7 font-light text-[clamp(20px,2.1vw,27px)]/[1.35] tracking-[-0.01em] max-w-[30ch] text-pretty">
          <Emphasis segments={hero.intro} />
        </p>
        <div class="flex flex-wrap gap-3 mt-10">
          <Button
            href="/resume/"
            size="xl"
            class="transition-[translate,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-[0_12px_24px_-12px_var(--color-ink)]"
          >
            {hero.resumeLink}
          </Button>
          <Button href="#contact" variant="outlined" size="xl">
            {hero.emailLink}
          </Button>
        </div>
      </div>
      <div class="mx-auto shrink-0 w-[min(100%,420px,40svh)] flex flex-col items-center gap-3.5">
        <NightToggle class="w-full" hints={hero.avatarHints}>
          <Avatar class="w-full" />
        </NightToggle>
      </div>
    </Container>
  </section>
  {marquee && marquee.length > 0 && <Marquee items={marquee} />}
  <Container
    as="section"
    id="about"
    class="flex flex-wrap gap-x-[clamp(32px,5vw,80px)] gap-y-6 py-[clamp(72px,9vw,128px)]"
  >
    <Eyebrow as="h2" class="basis-50 shrink-0 grow-0 pt-3">
      01 — {about.eyebrow}
    </Eyebrow>
    <div class="flex-[1_1_520px] min-w-0">
      <p class="font-serif text-[clamp(30px,3.6vw,50px)]/[1.12] tracking-[-0.01em] text-pretty">
        <Emphasis segments={about.lead} />
      </p>
      <p class="mt-7 font-light text-[19px]/[1.6] text-muted max-w-[58ch] text-pretty">
        <Emphasis segments={about.body} />
      </p>
    </div>
  </Container>
  <Container
    as="section"
    class="flex flex-wrap gap-x-[clamp(32px,5vw,80px)] gap-y-8 pb-[clamp(72px,9vw,128px)]"
  >
    <div class="flex-[0_1_320px]">
      <Eyebrow as="p" class="mb-3.5">
        02 — {experience.eyebrow}
      </Eyebrow>
      <h2 class="font-serif text-[clamp(44px,5vw,68px)]/none tracking-[-0.02em] mb-5.5">
        <Emphasis segments={experience.heading} />
      </h2>
      <TextLink href="/resume/">{experience.resumeLink}</TextLink>
    </div>
    <ul role="list" class="flex-[1_1_520px] min-w-0 border-b border-line">
      {roles.map((role) => (
        <li>
          <a
            href={`/resume/#${role.id}`}
            class="flex flex-wrap items-baseline gap-x-6 gap-y-2 py-5.5 border-t border-line text-ink no-underline motion-safe:transition-[padding] motion-safe:duration-350 motion-safe:ease-soft hover:pl-4 focus-visible:pl-4"
          >
            <span class="flex-[0_0_96px] font-mono font-medium text-xs text-muted">
              {formatYearSpan(role.start, role.end)}
            </span>
            <div class="flex-[1_1_280px] min-w-0">
              <div class="flex flex-wrap items-baseline gap-x-6 gap-y-1.5">
                <span class="grow font-serif text-[clamp(24px,2.3vw,30px)]/[1.15]">
                  {role.company}
                </span>
                <span class="text-[15px] text-muted">{role.title}</span>
              </div>
              {role.blurb && (
                <p class="mt-3 max-w-[62ch] font-light text-[15px]/[1.65] text-muted text-pretty">
                  {role.blurb}
                </p>
              )}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </Container>
  <ContactSection number="03" contact={contact} />
</Layout>

<script>
  // Moves the hero glow to the cursor, at most once a frame; the CSS transition makes it trail
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const glow = hero?.querySelector<HTMLElement>("[data-glow]");

  if (hero && glow) {
    let frame = 0;
    let x = 0;
    let y = 0;

    const follow = () => {
      frame = 0;
      const box = hero.getBoundingClientRect();
      glow.style.translate = `${x - box.left}px ${y - box.top}px`;
    };

    window.addEventListener("pointermove", (event) => {
      x = event.clientX;
      y = event.clientY;
      frame ||= requestAnimationFrame(follow);
    });
  }
</script>
